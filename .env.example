# ---------------------------------------------------------------------------
# VavaLink configuration. Copy to `.env` and adjust. Every value below is the
# default that applies when the variable is absent.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- HTTP server ----------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# `*` allows any origin (useful for a future browser dashboard).
CORS_ORIGIN=*
JSON_BODY_LIMIT=16kb
SHUTDOWN_TIMEOUT_MS=10000

# --- Audio / FFmpeg -------------------------------------------------------
# Absolute paths work too, e.g. FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
BINARY_PROBE_TIMEOUT_MS=5000
SAMPLE_RATE=48000
CHANNELS=2
DEFAULT_ENCODING=mp3
MP3_BITRATE_KBPS=128
FFMPEG_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# --- Source resolution ----------------------------------------------------
SEARCH_TIMEOUT_MS=12000
SEARCH_LIMIT=5

# Direct URLs and local files (no third-party dependency).
DIRECT_ENABLED=true
# YouTube and SoundCloud are resolved through yt-dlp.
YOUTUBE_ENABLED=true
SOUNDCLOUD_ENABLED=true

# --- yt-dlp ---------------------------------------------------------------
YT_DLP_PATH=yt-dlp
YT_DLP_TIMEOUT_MS=20000
# yt-dlp >= 2025 needs a JavaScript runtime for YouTube's EJS challenges.
YT_DLP_JS_RUNTIME=node
# Comma separated extra flags, e.g. --proxy,http://127.0.0.1:8080
YT_DLP_EXTRA_ARGS=

# --- Diagnostics ----------------------------------------------------------
HEALTH_VERBOSE=true